# Required for model-based review and editing. Without it the app uses a
# clearly-labelled deterministic fallback so the full workflow remains testable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=60000

# Optional but recommended. Both scholarly providers also allow limited
# anonymous requests.
SEMANTIC_SCHOLAR_API_KEY=
# Authenticated Semantic Scholar traffic is serialized at 1.1 seconds/request.
OPENALEX_API_KEY=

GROBID_URL=http://127.0.0.1:8070
DATA_DIR=./data
MAX_PDF_BYTES=20971520
